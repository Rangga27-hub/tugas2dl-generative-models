  "fid_samples": 7000,
  "fid_batch_size": 64,
  "timing_warmup": 3,
  "timing_repeats": 10,
  "normalization": {"ae": "[0,1]", "sparse_ae": "[0,1]", "vae": "[0,1]", "mlp": "[0,1]", "decoder": "[0,1]", "gan": "[-1,1]", "dcgan": "[-1,1]", "ddpm": "[-1,1]"},
  "checkpoint_selection": {"mlp": "maximum validation accuracy", "ae": "minimum validation objective", "sparse_ae": "minimum validation objective", "vae": "minimum validation ELBO loss", "decoder": "minimum validation MSE", "ddpm": "minimum fixed-noise validation MSE", "gan": "last epoch of predeclared budget", "dcgan": "last epoch of predeclared budget"}
